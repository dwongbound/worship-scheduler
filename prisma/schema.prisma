// Worship Scheduler data model.
//
// The core hierarchy:
//   Set        — one worship set: a start time + duration.
//   Assignment — one person filling one slot (role) on a set's team.
//                The "team" is simply a set's list of assignments.
//   User       — a person; can play multiple instruments and may be admin.
//
// Slot capacities (4 vocals, 1 worship leader, 2 keys, ...) are business
// logic, not schema — see lib/constants.ts SLOT_CAPACITIES.

generator client {
  // Prisma 7: the Rust-free "prisma-client" generator with a required output.
  // Import from "@/lib/generated/prisma/client" (see lib/prisma.ts).
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Instruments double as both a user's skills and a team slot's role.
enum Instrument {
  WORSHIP_LEADER
  VOCALS // support vocals
  ACOUSTIC_GUITAR
  ELECTRIC_GUITAR
  KEYS // piano / keys
  STRINGS
  DRUMS
  BASS
  // Choir is a special role: unlike the band roles above it has no fixed slot
  // count in the team shape (SLOT_CAPACITIES / ROLE_ORDER omit it). It's an
  // unbounded, admin-managed list on a set — the set-detail modal's "Auto
  // schedule" seats everyone on the team who's free, and admins add more by hand.
  CHOIR
}

// Lifecycle of an assignment:
//   PENDING        — auto-scheduled ("scheduled pending"), awaiting the
//                    user's manual confirmation.
//   CONFIRMED      — user accepted the set.
//   SWAP_REQUESTED — user wants out; visible to others with the same
//                    instrument until someone takes it (back to PENDING
//                    under the new user).
//   PENDING_SWAP   — part of a proposed targeted trade (see SwapProposal);
//                    frozen until the recipient accepts (both CONFIRMED) or
//                    rejects (both restored to their captured prior status).
enum AssignmentStatus {
  PENDING
  CONFIRMED
  SWAP_REQUESTED
  PENDING_SWAP
  // A cover/swap the recipient accepted or took — the slot already shows the
  // new person, but it's awaiting an admin's approval before it's final.
  PENDING_APPROVAL
}

enum UnavailabilityType {
  RECURRING // "general block": every Tuesday morning (always applies)
  SPECIFIC // "specific block": one date + time window, tied to a request
  DATE_RANGE // legacy: "Jan 5 – Jan 10" (no longer created by the UI)
}

// One entry in a set's activity log (SetDetailModal's History section).
//   ADDED          — a slot was filled: the auto-scheduler (actor = null) or
//                    an admin (actor = that admin) put targetUser in role.
//   REMOVED        — an admin cleared a filled slot.
//   REASSIGNED     — an admin swapped previousUser out for targetUser.
//   CONFIRMED      — targetUser confirmed their own slot.
//   SWAP_REQUESTED — targetUser asked to be swapped out of their slot.
//   SWAP_CANCELED  — targetUser withdrew their own swap request.
//   SWAP_TAKEN     — targetUser took over previousUser's swap-requested slot.
enum SetHistoryEventType {
  ADDED
  REMOVED
  REASSIGNED
  CONFIRMED
  SWAP_REQUESTED
  SWAP_CANCELED
  SWAP_TAKEN
  // A targeted swap proposed, and (once the recipient accepts) awaiting approval.
  SWAP_PROPOSED
  SWAP_ACCEPTED
  // Admin decision on a pending cover/swap.
  APPROVED
  REJECTED
}

// An organization — the highest-level tenant boundary (e.g. one church).
// Orgs are declared in the ORG_KEYS env var ("Name:key,Name:key"); rows here
// are auto-upserted from it by name (lib/org.ts ensureOrgsSynced). Renaming
// an org in env therefore creates a NEW org — existing data stays under the
// old name until manually renamed in the db.
model Org {
  id   String @id @default(cuid())
  name String @unique

  // The key someone redeems to join this org. Moved off the ORG_KEYS env var
  // into the db so orgs + keys are managed in-app (platform admin page) with
  // no redeploy. Nullable during the env→db backfill; rotatable.
  joinKey String? @unique

  // Per-org Slack workspace install (Flow B). The bot token is encrypted at
  // rest (lib/crypto) — never store it plaintext. Null = Slack not connected
  // for this org (lib/slack falls back to the env token during transition).
  slackTeamId    String?
  slackTeamName  String?
  slackBotToken  String?
  slackBotUserId String?

  // Per-org Spotify connection: ONE shared church account authorizes the app,
  // and every playlist this org creates lives under it. The long-lived OAuth
  // refresh token is encrypted at rest (lib/crypto) exactly like slackBotToken
  // — never plaintext. Null = Spotify not connected (lib/spotify no-ops). The
  // user id/display name are cosmetic (shown on the admin "connected as" row).
  spotifyRefreshToken String?
  spotifyUserId       String?
  spotifyDisplayName  String?

  memberships          OrgMembership[]
  teams                Team[]
  sets                 Set[]
  templates            SetTemplate[]
  availabilityRequests AvailabilityRequest[]
  reminders            WeeklyReminder[]

  createdAt DateTime @default(now())

  @@map("orgs")
}

// A user's membership in one org, created by entering that org's key.
// Admin is PER-ORG: this flag replaces the old global User.isAdmin.
model OrgMembership {
  id      String  @id @default(cuid())
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId   String
  isAdmin Boolean @default(false)

  // This user's Slack member id (U…) IN THIS ORG's workspace. Member ids are
  // workspace-scoped, so the same person has a different one per org — hence
  // it lives here, per membership, rather than once on User.
  slackUserId String?

  // When true, this person is added to EVERY Slack group chat created for this
  // org's sets — even sets they aren't assigned to (e.g. a ministry lead who
  // wants to be in every set's chat). Best-effort: needs a linked slackUserId.
  alwaysInGroupChats Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  // A Slack member id is unique within its workspace (= one org).
  @@unique([orgId, slackUserId])
  @@map("org_memberships")
}

// A ministry team (e.g. "Sunday Team", "Prayer Room Team") within one org.
// Users belong to any number of teams; every set (and template) targets one
// team, and the auto-scheduler only proposes people who belong to it.
model Team {
  id   String @id @default(cuid())
  name String

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String

  // Slack channel (C...) the bot posts this team's set summaries to. The bot
  // must be invited to the channel; null = Slack summaries off for this team.
  // (Per-set auto group chats are configured on the Set/SetTemplate, not here.)
  slackChannelId String?

  members   TeamMember[]
  // DEPRECATED: old role-less membership — see User.teams. Dropped after backfill.
  users     User[]           @relation("TeamMembers")
  sets      Set[]
  templates SetTemplate[]
  reminders WeeklyReminder[]
  // Availability requests aimed at this team (see AvailabilityRequest.teams).
  availabilityRequests AvailabilityRequest[] @relation("AvailabilityRequestTeams")

  createdAt DateTime @default(now())

  // Team names only need to be unique within their org.
  @@unique([orgId, name])
  @@map("teams")
}

// A person's membership on one team, carrying the roles they can fill ON THAT
// team. Replaces the old implicit User↔Team m-n so roles can differ per team
// (someone may play keys on Sunday but only sing on the Youth team). An empty
// `roles` list = on the team but not yet schedulable for anything.
model TeamMember {
  id     String @id @default(cuid())
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  roles Instrument[] // roles this person can fill on this team (may be empty)

  createdAt DateTime @default(now())

  // One membership row per person per team.
  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// A scheduled weekly Slack reminder: post one team's "this week's sets" summary
// to its Slack channel every week at a chosen day + time. The daily cron
// (app/api/cron/weekly-reminders) sends any whose dayOfWeek matches today and
// that hasn't gone out yet today (lastSentAt guards against double-sends).
model WeeklyReminder {
  id String @id @default(cuid())

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  dayOfWeek  Int // 0=Sun … 6=Sat, matching JS getDay()
  minute     Int // minutes from midnight (server TZ), the target send time
  lastSentAt DateTime? // last successful send, to dedupe within a day

  createdAt DateTime @default(now())

  // One reminder per team per weekday — a team can still have several across
  // different days.
  @@unique([teamId, dayOfWeek])
  @@map("weekly_reminders")
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String
  name         String
  email        String? @unique

  // Musical director: can be the designated MD on a set that requires one.
  // Note: isMD is global to the person, not per-org.
  isMD        Boolean      @default(false)
  // DEPRECATED: roles are now per-team (see TeamMember.roles). Kept only so the
  // backfill (prisma/backfillTeamRoles.ts) can copy each person's old global
  // roles onto their teams; a follow-up migration drops this column.
  instruments Instrument[]
  // Orgs this person belongs to (admin is per-org — see OrgMembership).
  memberships OrgMembership[]
  // Teams this person serves on, with the roles they play ON EACH team — only
  // sets of these teams schedule them, and only for roles listed here.
  teamMembers TeamMember[]
  // DEPRECATED: the old role-less team membership. Kept alongside teamMembers
  // only so the backfill can read existing edges; a follow-up migration drops it.
  teams       Team[]       @relation("TeamMembers")

  assignments           Assignment[]
  unavailability        Unavailability[]
  // One row per availability request the user has marked complete.
  availabilityResponses AvailabilityResponse[]

  // Set history: actions this user performed, was the subject of, or was
  // swapped/removed in favor of. See SetHistoryEvent for the relation roles.
  historyActed    SetHistoryEvent[] @relation("SetHistoryActor")
  historyTargeted SetHistoryEvent[] @relation("SetHistoryTarget")
  historyPrevious SetHistoryEvent[] @relation("SetHistoryPrevious")
  // Targeted swaps this person initiated / was offered (see SwapProposal).
  swapsRequested  SwapProposal[]    @relation("SwapRequestedBy")
  swapsReceived   SwapProposal[]    @relation("SwapRecipient")
  // Sets where this person is the designated musical director.
  mdSets          Set[]             @relation("SetMD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// The smallest schedulable unit: a block of time needing a team.
model Set {
  id              String   @id @default(cuid())
  label           String? // e.g. "Sunday Morning Service"
  startsAt        DateTime
  durationMinutes Int
  notes           String? // free-form notes shown in the set detail modal

  // When true, this set needs a musical director; the scheduler seats one and
  // the UI shows the MD picker + a warning until one is chosen.
  requiresMD Boolean @default(false)

  // When true, this is a "private" ad-hoc set: only org admins and the people
  // assigned to it can see it (GET /api/sets filters it out for everyone else).
  // Default false = a normal set visible to the whole org.
  isPrivate Boolean @default(false)

  // Choir is opt-in PER SET: an admin flips this on before anyone can be added
  // to the set's choir or auto-scheduled into it. Default false = no choir on
  // this set (the choir section is off and "Auto schedule" skips choir).
  choirEnabled Boolean @default(false)

  // Auto-create this set's private Slack channel this many days before it
  // starts (the daily cron does it). Null = off. Copied from the SetTemplate at
  // generate time; editable per set. Distinct from Team.slackChannelId (the
  // team's standing channel for weekly summaries) — this is a per-set chat.
  groupChatLeadDays Int?

  // When the cron created this set's Slack channel, so it's only made once.
  // Null = not created yet (or the feature is off for this set).
  groupChatCreatedAt DateTime?

  // The private Slack channel (C…) created for this set, so the archive cron can
  // find it after the event. Null until the channel is created.
  groupChatChannelId String?

  // When the cron archived this set's channel (once the event date passed), so
  // it's only archived once. Null = still open (or never had a channel).
  groupChatArchivedAt DateTime?

  // The one designated MD for this set. Always someone assigned in an
  // MD-capable role (keys/electric/bass) and never the worship leader — see
  // lib/md.ts for the eligibility rule. Null = no MD chosen yet. SetNull so
  // deleting the user just clears the designation, not the set.
  md       User?   @relation("SetMD", fields: [mdUserId], references: [id], onDelete: SetNull)
  mdUserId String?

  // Per-set team shape: an Instrument→count map (e.g. { ELECTRIC_GUITAR: 2,
  // ACOUSTIC_GUITAR: 0 }). Null = use the global SLOT_CAPACITIES default.
  // Copied from the SetTemplate at generate time; editable per ad-hoc set.
  slotCapacities Json?

  // The org this set belongs to — the tenant anchor even when teamId is null.
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String

  // The team this set is for — only its members are auto-scheduled onto it.
  // Nullable so deleting a team orphans (not deletes) its sets; a null team
  // means "open to everyone in the org".
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId String?

  // The worship leader's setlist for this set — ordered list of songs (title +
  // key). Cascade-deletes with the set. Drives the Spotify playlist and (later)
  // the per-set Drive chart folder.
  songs Song[]

  // The collaborative Spotify playlist created for this set (under the org's
  // shared account), so a re-sync updates the SAME playlist instead of making a
  // duplicate. Both null until a playlist is first created. The url is the
  // shareable link posted into the set's Slack group chat.
  spotifyPlaylistId  String?
  spotifyPlaylistUrl String?

  assignments Assignment[]
  history     SetHistoryEvent[]

  createdAt DateTime @default(now())

  @@map("sets")
}

// One song in a set's setlist. The worship leader enters a title and (optional)
// musical key; `order` is the 0-based position in the list. Title feeds the
// Spotify search (first result) and — later — the Drive chart lookup, which
// matches files named "<title> (<key>).pdf".
model Song {
  id    String @id @default(cuid())
  set   Set    @relation(fields: [setId], references: [id], onDelete: Cascade)
  setId String

  title String
  key   String? // musical key, e.g. "C", "Bb" (see SONG_KEYS); null = unspecified
  order Int // 0-based position in the setlist

  createdAt DateTime @default(now())

  @@index([setId])
  @@map("songs")
}

// One user filling one role slot on one set.
model Assignment {
  id     String           @id @default(cuid())
  set    Set              @relation(fields: [setId], references: [id], onDelete: Cascade)
  setId  String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Instrument
  status AssignmentStatus @default(PENDING)

  // Optional note the owner leaves when requesting cover (status
  // SWAP_REQUESTED) — shown to people who could take the set. Cleared when the
  // request is cancelled/confirmed/taken.
  swapReason String?

  // While a cover-take is PENDING_APPROVAL, the slot already shows the taker;
  // this holds the original owner so an admin REJECT can re-open the cover to
  // them. Null except during that window. (No FK — it's a transient pointer.)
  pendingCoverFromUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Targeted swaps this assignment is either side of (see SwapProposal).
  swapFrom SwapProposal[] @relation("SwapFrom")
  swapTo   SwapProposal[] @relation("SwapTo")

  // A person can hold several roles on one set (e.g. worship leader + acoustic
  // guitar) but never the same role twice.
  @@unique([setId, userId, role])
  @@map("assignments")
}

// A targeted swap ("trade") between two assignments in the SAME role: the
// requester offers their slot (fromAssignment) for someone else's
// (toAssignment). While PENDING both assignments sit at PENDING_SWAP;
// accepting exchanges their users (both CONFIRMED), rejecting restores the
// captured prior statuses. Only one PENDING proposal may touch a given
// assignment at a time (enforced in the API, not the schema).
model SwapProposal {
  id String @id @default(cuid())

  fromAssignment   Assignment @relation("SwapFrom", fields: [fromAssignmentId], references: [id], onDelete: Cascade)
  fromAssignmentId String
  toAssignment     Assignment @relation("SwapTo", fields: [toAssignmentId], references: [id], onDelete: Cascade)
  toAssignmentId   String

  // Who initiated the trade (owns fromAssignment); the recipient (owner of
  // toAssignment) is who accepts or rejects it. recipientId is captured
  // explicitly because toAssignment.userId flips to the requester on accept —
  // so it's the only durable record of who received (and possibly accepted) it.
  requestedBy   User   @relation("SwapRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  requestedById String
  recipient     User   @relation("SwapRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId   String

  // Optional note the proposer leaves — shown to the recipient with the trade.
  reason String?

  status SwapProposalStatus @default(PENDING)

  // Captured at propose-time so a reject restores each side exactly.
  fromPrevStatus AssignmentStatus
  toPrevStatus   AssignmentStatus

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([toAssignmentId, status])
  @@index([fromAssignmentId, status])
  @@index([requestedById])
  @@index([recipientId, status])
  @@map("swap_proposals")
}

enum SwapProposalStatus {
  PENDING
  // The recipient accepted; now awaiting an admin's approval before it's final.
  PENDING_APPROVAL
  ACCEPTED
  REJECTED
  CANCELED
}

// One line in a set's activity log — see SetHistoryEventType for what each
// type means. Written alongside the assignment change it describes, never
// edited afterwards.
model SetHistoryEvent {
  id     String              @id @default(cuid())
  set    Set                 @relation(fields: [setId], references: [id], onDelete: Cascade)
  setId  String
  type   SetHistoryEventType
  role   Instrument

  // Who performed the action; null = the auto-scheduler (no human actor).
  actor   User?   @relation("SetHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  // The person the slot belongs to after this event.
  targetUser   User?   @relation("SetHistoryTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserId String?

  // For REASSIGNED and SWAP_TAKEN: who held the slot immediately before.
  previousUser   User?   @relation("SetHistoryPrevious", fields: [previousUserId], references: [id], onDelete: SetNull)
  previousUserId String?

  createdAt DateTime @default(now())

  @@index([setId, createdAt])
  @@map("set_history_events")
}

// Times a user CANNOT serve. Three shapes share one table:
//   RECURRING : dayOfWeek + startMinute..endMinute (minutes from midnight)
//   SPECIFIC  : startDate (the day) + startMinute..endMinute, tied to a request
//   DATE_RANGE: startDate..endDate (inclusive) — legacy
model Unavailability {
  id     String             @id @default(cuid())
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  type   UnavailabilityType

  // RECURRING fields — 0 = Sunday ... 6 = Saturday
  dayOfWeek   Int?
  // Time window (minutes from midnight) — RECURRING and SPECIFIC.
  startMinute Int?
  endMinute   Int?

  // SPECIFIC uses startDate as the single day; DATE_RANGE uses both.
  startDate DateTime?
  endDate   DateTime?

  // Set for SPECIFIC blocks (the TimeRange they belong to); null otherwise.
  request   AvailabilityRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String?

  note String?

  createdAt DateTime @default(now())

  @@map("unavailability")
}

// Admin-defined weekly recurrence, e.g. "every Monday 19:00 for 60 min".
// The generate endpoint expands these into concrete Set rows.
model SetTemplate {
  id              String @id @default(cuid())
  label           String
  dayOfWeek       Int // 0 = Sunday ... 6 = Saturday
  startMinute     Int // minutes from midnight, e.g. 19:00 = 1140
  durationMinutes Int

  // Sets expanded from this template inherit this "needs an MD" flag.
  requiresMD Boolean @default(false)

  // The team shape this template's sets should have — see Set.slotCapacities.
  // Null = use the global SLOT_CAPACITIES default.
  slotCapacities Json?

  // Sets expanded from this template inherit this per-set auto group-chat lead
  // time (see Set.groupChatLeadDays). Null = off for the generated sets.
  groupChatLeadDays Int?

  // The org this template (and its expanded sets) belongs to.
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String

  // Sets expanded from this template belong to this team (see Set.team).
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId String?

  createdAt DateTime @default(now())

  @@map("set_templates")
}

// An admin's request for the team to enter their availability over a date
// range. The most recent row PER ORG **that targets you** is your "active"
// request for that org; you owe a response for each of them. Drives the
// Availabilities red dot + banner, and the Create tab's status panel.
model AvailabilityRequest {
  id        String   @id @default(cuid())
  // Optional admin-given name (e.g. "Fall 2026"); the UI falls back to the
  // date range when it's null.
  name      String?
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String

  // The teams this request is aimed at — only their members are asked to fill
  // it in (see lib/availabilityTargets.ts). The admin picks them at creation time,
  // defaulting to every team in the org. EMPTY means "the whole org": that's
  // how rows created before team targeting behave, and the fallback for an org
  // with no teams yet.
  teams Team[] @relation("AvailabilityRequestTeams")

  // Specific blocks entered against this request + who has marked it complete.
  unavailability Unavailability[]
  responses      AvailabilityResponse[]

  @@map("availability_requests")
}

// One row per (user, request) once the user hits "I'm done scheduling" for
// that request. Presence = complete; absence = still owes a response. Replaces
// the old global User.scheduleCompletedAt so completion is tracked per request.
model AvailabilityResponse {
  id        String              @id @default(cuid())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  request   AvailabilityRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  // null = the row exists but is currently marked "not submitted". The row
  // persists across un/re-submits so we can remember it was edited.
  completedAt DateTime?
  // True once re-submitted after having been un-submitted at least once.
  edited      Boolean           @default(false)

  @@unique([userId, requestId])
  @@map("availability_responses")
}
